{{ 'image-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .exshop-image-text__heading {
      font-size: {{ section.settings.heading_font_size }}px;
    }
  }

  .exshop-image-text__heading {
    font-size: {{ section.settings.mobile_heading_font_size }}px;
  }

  .exshop-image-text--{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .exshop-image-text__heading--{{ section.id }} {
    color: {{ section.settings.heading_color }};
  }

  .exshop-image-text__label--{{ section.id }} {
    color: {{ section.settings.label_color }};
  }

  .exshop-image-text__quote--{{ section.id }} {
    color: {{ section.settings.quote_color }};
  }

  .exshop-image-text__cards {
    gap: {{ section.settings.row_gap }}px {{ section.settings.column_gap }}px;
  }

  .exshop-image-text__image-container {
    background-color: {{ section.settings.image_container_bg_color }};
  }

  .exshop-image-text__label {
    font-size: {{ section.settings.label_font_size }}px;
  }

  .exshop-image-text__name {
    font-size: {{ section.settings.name_font_size }}px;
  }

  .exshop-image-text__quote {
    font-size: {{ section.settings.quote_font_size }}px;
  }

  .exshop-image-text__description {
    font-size: {{ section.settings.description_font_size }}px;
  }

  @media screen and (min-width: 750px) {
    .exshop-image-text__label {
      font-size: {{ section.settings.label_font_size_tablet }}px;
    }

    .exshop-image-text__quote {
      font-size: {{ section.settings.quote_font_size_tablet }}px;
    }
  }

  @media screen and (min-width: 750px) {
    .exshop-image-text__cards {
      gap: {{ section.settings.row_gap_tablet | default: section.settings.row_gap }}px {{ section.settings.column_gap_tablet | default: section.settings.column_gap }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .exshop-image-text__cards {
      gap: {{ section.settings.row_gap_desktop | default: section.settings.row_gap }}px {{ section.settings.column_gap_desktop | default: section.settings.column_gap }}px;
    }
  }
{%- endstyle -%}

<section class="exshop-image-text exshop-image-text--{{ section.id }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="exshop-image-text__header">
        <h1 class="exshop-image-text__heading exshop-image-text__heading--{{ section.id }}">
          {{ section.settings.heading }}
        </h1>
      </div>
    {%- endif -%}

    <div class="exshop-image-text__cards grid grid--{{ section.settings.columns_mobile }}-col grid--{{ section.settings.columns_tablet }}-col-tablet grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- for block in section.blocks -%}
        <div class="exshop-image-text__card-wrapper ddgrid__item" {{ block.shopify_attributes }}>
          <div class="exshop-image-text__card">
            {%- if block.settings.image != blank -%}
              <div class="exshop-image-text__image-container">
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw'
                }}
              </div>
            {%- endif -%}

            <div class="exshop-image-text__content">
              {%- if block.settings.label != blank -%}
                <p class="exshop-image-text__label exshop-image-text__label--{{ section.id }}">
                  {{ block.settings.label }}
                </p>
              {%- endif -%}

              {%- if block.settings.name != blank -%}
                <h3 class="exshop-image-text__name">
                  {{ block.settings.name }}
                </h3>
              {%- endif -%}

              {%- if block.settings.quote != blank -%}
                <p class="exshop-image-text__quote exshop-image-text__quote--{{ section.id }}">
                  "{{ block.settings.quote }}"
                </p>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <div class="exshop-image-text__description">
                  {{ block.settings.description }}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image & Text",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "It started with people, not a product."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "quote_color",
