    {
      "name": "Image & Text",
      "blocks": [
        {
          "type": "profile_card",
          "settings": {
            "label": "CO-FOUNDER • WORKSHOP",
            "name": "Hrvoje Vampovac",
            "quote": "If something carries your name, it had better be worth the years it takes to build it right.",
            "description": "<p>CEO of Tvoj studio. He didn't inherit a business – he inherited a standard. Eight years developing a mechanism that looked impossible, until it wasn't</p>"
