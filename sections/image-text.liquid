    {
      "type": "range",
      "id": "mobile_heading_font_size",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Mobile Heading font size",
      "default": 28
    },
    {
      "type": "range",
      "id": "label_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Label font size (mobile)",
      "default": 11
    },
    {
      "type": "range",
      "id": "label_font_size_tablet",
      "min": 10,
