{%- liquid
  assign section_id = section.id
  assign s = section.settings
-%}

{%- style -%}
  .in-real-homes--{{ section_id }} {
    --irh-bg: {{ s.background_color | default: '#ffffff' }};
    --irh-text: {{ s.text_color | default: '#14110e' }};
    --irh-accent: {{ s.accent_color | default: '#c79b6b' }};
    --irh-desc: {{ s.description_color | default: '#5c564f' }};
    --irh-award-bg: {{ s.award_bg_color | default: '#f7f5f0' }};
    --irh-award-text: {{ s.award_text_color | default: '#14110e' }};
    --irh-max-width: {{ s.container_width | default: 1320 }}px;
    --irh-pad-top: {{ s.padding_top | default: 80 }}px;
    --irh-pad-bottom: {{ s.padding_bottom | default: 80 }}px;

    position: relative;
    width: 100%;
    background-color: var(--irh-bg);
    color: var(--irh-text);
    padding-top: var(--irh-pad-top);
    padding-bottom: var(--irh-pad-bottom);
    box-sizing: border-box;
  }

  .in-real-homes--{{ section_id }} * {
    box-sizing: border-box;
  }

  .in-real-homes__container {
    width: 100%;
    max-width: var(--irh-max-width);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* ---------- Header & Award Badge ---------- */

  .in-real-homes__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 44px;
    gap: 28px;
  }

  .in-real-homes__header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .in-real-homes__eyebrow {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--irh-accent);
    margin-bottom: 12px;
  }

  .in-real-homes__heading {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 52px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--irh-text);
  }

  /* Award Badge */

  .in-real-homes__award {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background-color: var(--irh-award-bg);
    padding: 12px 18px;
    border: 1px solid rgba(20, 17, 14, 0.05);
    flex-shrink: 0;
    margin-bottom: 4px;
  }

  .in-real-homes__award-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #ece6dc;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--irh-accent);
    overflow: hidden;
  }

  .in-real-homes__award-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .in-real-homes__award-icon svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .in-real-homes__award-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .in-real-homes__award-label {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c867f;
  }

  .in-real-homes__award-title {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--irh-award-text);
  }

  /* ---------- 3-Column Card Grid ---------- */

  .in-real-homes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Individual Card ---------- */

  .in-real-homes__card {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 13;
    min-height: 340px;
    overflow: hidden;
    background-color: #f2ece4;
    display: block;
    text-decoration: none;
    color: #ffffff;
  }

  .in-real-homes__image-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .in-real-homes__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .in-real-homes__card:hover .in-real-homes__image {
    transform: scale(1.04);
  }

  .in-real-homes__card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e2d8;
    color: #a89f91;
  }

  .in-real-homes__card-placeholder svg {
    width: 60px;
    height: 60px;
    opacity: 0.6;
  }

  /* Gradient Overlay */

  .in-real-homes__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.82) 0%,
      rgba(0, 0, 0, 0.5) 32%,
      rgba(0, 0, 0, 0.1) 65%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 1;
    transition: opacity 0.3s ease;
    display:block !important;
  }

  /* Card Content */

  .in-real-homes__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 22px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    z-index: 2;
  }

  .in-real-homes__text-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
    min-width: 0;
  }

  .in-real-homes__location {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .in-real-homes__quote {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.01em;
    color: #ffffff;
    margin: 0;
  }

  .in-real-homes__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
    margin-bottom: 2px;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .in-real-homes__arrow svg {
    width: 16px;
    height: 16px;
    display: block;
    stroke-width: 1.8;
  }

  .in-real-homes__card:hover .in-real-homes__arrow {
    transform: translate(3px, -3px);
    color: var(--irh-accent);
  }

  /* ---------- Footer (Description + CTA) ---------- */

  .in-real-homes__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 48px;
    gap: 22px;
  }

  .in-real-homes__description {
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--irh-desc);
    margin: 0;
    max-width: 600px;
  }

  .in-real-homes__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 30px;
    background-color: transparent;
    border: 1px solid var(--irh-text);
    color: var(--irh-text);
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    border-radius: 0;
  }

  .in-real-homes__button svg {
    width: 13px;
    height: 13px;
    display: block;
    stroke-width: 2;
    transition: transform 0.25s ease;
  }

  .in-real-homes__button:hover {
    background-color: var(--irh-text);
    color: #ffffff;
    border-color: var(--irh-text);
  }

  .in-real-homes__button:hover svg {
    transform: translate(2px, -2px);
  }

  /* ---------- Responsive Styles ---------- */

  @media screen and (max-width: 989px) {
    .in-real-homes--{{ section_id }} {
      --irh-pad-top: {{ s.padding_top | default: 80 | times: 0.75 | round }}px;
      --irh-pad-bottom: {{ s.padding_bottom | default: 80 | times: 0.75 | round }}px;
    }

    .in-real-homes__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 36px;
    }

    .in-real-homes__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .in-real-homes__card:last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }

  @media screen and (max-width: 749px) {
    .in-real-homes--{{ section_id }} {
      --irh-pad-top: {{ s.padding_top | default: 80 | times: 0.6 | round }}px;
      --irh-pad-bottom: {{ s.padding_bottom | default: 80 | times: 0.6 | round }}px;
    }

    .in-real-homes__container {
      padding-left: 20px;
      padding-right: 20px;
    }

    .in-real-homes__header {
      margin-bottom: 28px;
      gap: 16px;
    }

    .in-real-homes__eyebrow {
      font-size: 12px;
      margin-bottom: 8px;
    }

    .in-real-homes__heading {
      font-size: clamp(30px, 8vw, 38px);
    }

    .in-real-homes__award {
      width: 100%;
      padding: 12px 14px;
    }

    .in-real-homes__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .in-real-homes__card,
    .in-real-homes__card:last-child:nth-child(odd) {
      grid-column: auto;
      aspect-ratio: 4 / 3;
      min-height: 290px;
    }

    .in-real-homes__content {
      padding: 18px 16px;
    }

    .in-real-homes__quote {
      font-size: 13.5px;
    }

    .in-real-homes__footer {
      margin-top: 36px;
      gap: 18px;
    }

    .in-real-homes__description {
      font-size: 14px;
    }

    .in-real-homes__button {
      width: 100%;
      max-width: 320px;
    }
  }
{%- endstyle -%}

<section
  class="in-real-homes in-real-homes--{{ section_id }}"
  id="in-real-homes-{{ section_id }}"
  data-section-id="{{ section_id }}"
>
  <div class="in-real-homes__container">
    <!-- Section Header -->
    <div class="in-real-homes__header">
      <div class="in-real-homes__header-left">
        {%- if s.eyebrow != blank -%}
          <div class="in-real-homes__eyebrow">
            {{ s.eyebrow }}
          </div>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="in-real-homes__heading">
            {{ s.heading }}
          </h2>
        {%- endif -%}
      </div>

      <!-- Award Badge -->
      {%- if s.enable_award -%}
        <div class="in-real-homes__award">
          <div class="in-real-homes__award-icon">
            {%- if s.award_icon != blank -%}
              {{ s.award_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: s.award_title | default: 'Award icon' }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0L14.6 9.4L24 12L14.6 14.6L12 24L9.4 14.6L0 12L9.4 9.4L12 0Z"/>
              </svg>
            {%- endif -%}
          </div>
          <div class="in-real-homes__award-text">
            {%- if s.award_label != blank -%}
              <span class="in-real-homes__award-label">{{ s.award_label }}</span>
            {%- endif -%}
            {%- if s.award_title != blank -%}
              <span class="in-real-homes__award-title">{{ s.award_title }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <!-- 3 Cards Grid -->
    {%- if section.blocks.size > 0 -%}
      <div class="in-real-homes__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign overlay_val = b.overlay_opacity | default: 60 | divided_by: 100.0
            assign custom_style = ''
            if b.custom_text_color != blank and b.custom_text_color != 'rgba(0,0,0,0)'
              assign custom_style = 'color: ' | append: b.custom_text_color | append: ';'
            endif
          -%}

          {%- if b.card_link != blank -%}
            <a
              href="{{ b.card_link }}"
              class="in-real-homes__card"
              {{ block.shopify_attributes }}
              {% if custom_style != blank %}style="{{ custom_style }}"{% endif %}
            >
          {%- else -%}
            <div
              class="in-real-homes__card"
              {{ block.shopify_attributes }}
              {% if custom_style != blank %}style="{{ custom_style }}"{% endif %}
            >
          {%- endif -%}

            <div class="in-real-homes__image-wrapper">
              {%- if b.image != blank -%}
                {{
                  b.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    class: 'in-real-homes__image',
                    alt: b.quote | default: b.location | default: 'In Real Homes gallery image'
                }}
              {%- else -%}
                <div class="in-real-homes__card-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>

            <div
              class="in-real-homes__overlay"
              style="opacity: {{ overlay_val }};"
            ></div>

            <div class="in-real-homes__content">
              <div class="in-real-homes__text-wrap">
                {%- if b.location != blank -%}
                  <p class="in-real-homes__location">{{ b.location }}</p>
                {%- endif -%}
                {%- if b.quote != blank -%}
                  <p class="in-real-homes__quote" {% if custom_style != blank %}style="{{ custom_style }}"{% endif %}>
                    {{ b.quote }}
                  </p>
                {%- endif -%}
              </div>

              {%- if b.enable_arrow -%}
                <div class="in-real-homes__arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </div>
              {%- endif -%}
            </div>

          {%- if b.card_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Footer: Description & CTA Button -->
    {%- if s.description != blank or s.button_text != blank -%}
      <div class="in-real-homes__footer">
        {%- if s.description != blank -%}
          <p class="in-real-homes__description">
            {{ s.description }}
          </p>
        {%- endif -%}

        {%- if s.button_text != blank -%}
          <a
            href="{{ s.button_url | default: '#' }}"
            class="in-real-homes__button"
          >
            <span>{{ s.button_text }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "In Real Homes",
  "tag": "section",
  "class": "section-in-real-homes",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "IN REAL HOMES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "At the table."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Bottom description text",
      "default": "Share your table — we'll feature the best each month."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHARE YOUR GATHERING"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Award Badge"
    },
    {
      "type": "checkbox",
      "id": "enable_award",
      "label": "Show award badge",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "award_icon",
      "label": "Custom award icon"
    },
    {
      "type": "text",
      "id": "award_label",
      "label": "Award small label",
      "default": "BIG SEE PRODUCT DESIGN AWARD"
    },
    {
      "type": "text",
      "id": "award_title",
      "label": "Award title",
      "default": "WINNER 2025 — SOUTHEAST EUROPE"
    },
    {
      "type": "color",
      "id": "award_bg_color",
      "label": "Award background color",
      "default": "#f7f5f0"
    },
    {
      "type": "color",
      "id": "award_text_color",
      "label": "Award text color",
      "default": "#14110e"
    },
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & text color",
      "default": "#14110e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (Eyebrow & icon)",
      "default": "#c79b6b"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description text color",
      "default": "#5c564f"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container maximum width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location text",
          "default": "ZAGREB, CROATIA"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote / description",
          "default": "“Sunday dinner for ten — extended in moments.”"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card link"
        },
        {
          "type": "checkbox",
          "id": "enable_arrow",
          "label": "Show diagonal arrow",
          "default": true
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Dark overlay opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 60
        },
        {
          "type": "color",
          "id": "custom_text_color",
          "label": "Custom text color (optional)",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "In Real Homes",
      "settings": {
        "eyebrow": "IN REAL HOMES",
        "heading": "At the table.",
        "description": "Share your table — we'll feature the best each month.",
        "button_text": "SHARE YOUR GATHERING",
        "enable_award": true,
        "award_label": "BIG SEE PRODUCT DESIGN AWARD",
        "award_title": "WINNER 2025 — SOUTHEAST EUROPE"
      },
      "blocks": [
        {
          "type": "card",
          "settings": {
            "location": "ZAGREB, CROATIA",
            "quote": "“Sunday dinner for ten — extended in moments.”",
            "enable_arrow": true,
            "overlay_opacity": 60
          }
        },
        {
          "type": "card",
          "settings": {
            "location": "BOSTON, MA",
            "quote": "“We use it every day — compact for breakfast, full for dinner parties.”",
            "enable_arrow": true,
            "overlay_opacity": 60
          }
        },
        {
          "type": "card",
          "settings": {
            "location": "LONDON, UK",
            "quote": "“A city apartment that seats twelve when it needs to.”",
            "enable_arrow": true,
            "overlay_opacity": 60
          }
        }
      ]
    }
  ]
}
{% endschema %}
