<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet">

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign blog_obj = s.blog
  assign post_limit = s.post_limit | default: 4
-%}

{%- style -%}
  .journal-blog--{{ section_id }} {
    --jbp-bg: {{ s.background_color | default: '#ffffff' }};
    --jbp-text: {{ s.text_color | default: '#14110e' }};
    --jbp-accent: {{ s.accent_color | default: '#c79b6b' }};
    --jbp-meta: {{ s.meta_color | default: '#8c867f' }};
    --jbp-excerpt: {{ s.excerpt_color | default: '#5c564f' }};
    --jbp-max-width: {{ s.container_width | default: 1320 }}px;
    --jbp-gap: {{ s.grid_gap | default: 24 }}px;
    --jbp-pad-top: {{ s.padding_top | default: 80 }}px;
    --jbp-pad-bottom: {{ s.padding_bottom | default: 80 }}px;

    position: relative;
    width: 100%;
    background-color: var(--jbp-bg);
    color: var(--jbp-text);
    padding-top: var(--jbp-pad-top);
    padding-bottom: var(--jbp-pad-bottom);
    box-sizing: border-box;
  }

  .journal-blog--{{ section_id }} * {
    box-sizing: border-box;
  }

  .journal-blog__container {
    width: 100%;
    max-width: var(--jbp-max-width);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* ---------- Header ---------- */

  .journal-blog__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 44px;
    gap: 24px;
  }

  .journal-blog__header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .journal-blog__eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--jbp-accent);
    margin-bottom: 12px;
  }

  .journal-blog__heading {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 600;
    font-size: clamp(36px, 4.4vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--jbp-text);
  }

  .journal-blog__view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--jbp-text);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
    padding-bottom: 4px;
    transition: color 0.25s ease, opacity 0.25s ease;
    flex-shrink: 0;
  }

  .journal-blog__view-all:hover {
    color: var(--jbp-accent);
  }

  .journal-blog__view-all svg {
    width: 12px;
    height: 12px;
    display: block;
    stroke-width: 2;
    transition: transform 0.25s ease;
  }

  .journal-blog__view-all:hover svg {
    transform: translate(2px, -2px);
  }

  /* ---------- 4-Column Grid ---------- */

  .journal-blog__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--jbp-gap);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Individual Card ---------- */

  .journal-blog__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    width: 100%;
    group: card;
  }

  .journal-blog__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f4efe8;
    margin-bottom: 18px;
  }

  .journal-blog__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.55s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .journal-blog__card:hover .journal-blog__image {
    transform: scale(1.04);
  }

  .journal-blog__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eae3d8;
    color: #9d9385;
  }

  .journal-blog__placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }

  /* Card Content */

  .journal-blog__content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .journal-blog__meta {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--jbp-meta);
    margin: 0 0 8px 0;
  }

  .journal-blog__title {
    margin: 0 0 8px 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(19px, 1.4vw, 21px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--jbp-text);
    transition: color 0.25s ease;
        display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .journal-blog__card:hover .journal-blog__title {
    color: var(--jbp-accent);
  }

  .journal-blog__excerpt {
    margin: 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--jbp-excerpt);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .journal-blog__excerpt p {
    margin: 0;
  }

  /* ---------- Responsive Styles ---------- */

  @media screen and (max-width: 989px) {
    .journal-blog--{{ section_id }} {
      --jbp-pad-top: {{ s.padding_top | default: 80 | times: 0.75 | round }}px;
      --jbp-pad-bottom: {{ s.padding_bottom | default: 80 | times: 0.75 | round }}px;
    }

    .journal-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 20px;
    }

    .journal-blog__header {
      margin-bottom: 36px;
    }
  }

  @media screen and (max-width: 749px) {
    .journal-blog--{{ section_id }} {
      --jbp-pad-top: {{ s.padding_top | default: 80 | times: 0.6 | round }}px;
      --jbp-pad-bottom: {{ s.padding_bottom | default: 80 | times: 0.6 | round }}px;
    }

    .journal-blog__container {
      padding-left: 20px;
      padding-right: 20px;
    }

    .journal-blog__header {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 28px;
      gap: 16px;
    }

    .journal-blog__eyebrow {
      font-size: 12px;
      margin-bottom: 8px;
    }

    .journal-blog__heading {
      font-size: clamp(30px, 8vw, 38px);
    }

    .journal-blog__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .journal-blog__image-wrapper {
      margin-bottom: 14px;
    }

    .journal-blog__title {
      font-size: 20px;
    }
  }
{%- endstyle -%}

<section
  class="journal-blog journal-blog--{{ section_id }}"
  id="journal-blog-{{ section_id }}"
  data-section-id="{{ section_id }}"
>
  <div class="page-width">
    <!-- Header -->
    <div class="journal-blog__header">
      <div class="journal-blog__header-left">
        {%- if s.eyebrow != blank -%}
          <div class="journal-blog__eyebrow">
            {{ s.eyebrow }}
          </div>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="journal-blog__heading">
            {{ s.heading }}
          </h2>
        {%- endif -%}
      </div>

      {%- if s.view_all_text != blank -%}
        {%- assign view_all_link = s.view_all_url | default: blog_obj.url | default: '#' -%}
        <a
          href="{{ view_all_link }}"
          class="journal-blog__view-all"
        >
          <span>{{ s.view_all_text }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <!-- Blog Grid -->
    <div class="journal-blog__grid">
      {%- if blog_obj != blank and blog_obj.articles_count > 0 -%}
        {%- for article in blog_obj.articles limit: post_limit -%}
          <a
            href="{{ article.url }}"
            class="journal-blog__card"
          >
            {%- if s.show_image -%}
              <div class="journal-blog__image-wrapper">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 400, 600, 800',
                      class: 'journal-blog__image',
                      alt: article.image.alt | default: article.title
                  }}
                {%- else -%}
                  <div class="journal-blog__placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="journal-blog__content">
              {%- if s.show_category or s.show_date -%}
                <div class="journal-blog__meta">
                  {%- if s.show_category -%}
                    <span>{{ article.tags.first | default: blog_obj.title | upcase }}</span>
                  {%- endif -%}
                  {%- if s.show_category and s.show_date -%}
                    <span> / </span>
                  {%- endif -%}
                  {%- if s.show_date -%}
                    <span>{{ article.published_at | date: '%B %Y' | upcase }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <h3 class="journal-blog__title">
                {{ article.title }}
              </h3>

              {%- if s.show_excerpt -%}
                <div class="journal-blog__excerpt">
                  {%- if article.excerpt.size > 0 -%}
                    {{ article.excerpt | strip_html | truncate: s.excerpt_limit }}
                  {%- else -%}
                    {{ article.content | strip_html | truncate: s.excerpt_limit }}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Onboarding / Fallback Matching Figma Node 33-3814 -->
        <div class="journal-blog__card">
          <div class="journal-blog__image-wrapper">
            <div class="journal-blog__placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          </div>
          <div class="journal-blog__content">
            <div class="journal-blog__meta">
              AROUND THE TABLE / MAY 2026
            </div>
            <h3 class="journal-blog__title">
              The dinner that grew unexpectedly.
            </h3>
            <div class="journal-blog__excerpt">
              It started as six. By 9pm there were eleven...
            </div>
          </div>
        </div>

        <div class="journal-blog__card">
          <div class="journal-blog__image-wrapper">
            <div class="journal-blog__placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          </div>
          <div class="journal-blog__content">
            <div class="journal-blog__meta">
              RECIPE / MAY 2026
            </div>
            <h3 class="journal-blog__title">
              A recipe for a long evening.
            </h3>
            <div class="journal-blog__excerpt">
              Burrata, good bread, something slow-roas...
            </div>
          </div>
        </div>

        <div class="journal-blog__card">
          <div class="journal-blog__image-wrapper">
            <div class="journal-blog__placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          </div>
          <div class="journal-blog__content">
            <div class="journal-blog__meta">
              IN THE HOME / MAY 2026
            </div>
            <h3 class="journal-blog__title">
              From Tuesday breakfast to Saturday dinner.
            </h3>
            <div class="journal-blog__excerpt">
              The same surface, completely different en...
            </div>
          </div>
        </div>

        <div class="journal-blog__card">
          <div class="journal-blog__image-wrapper">
            <div class="journal-blog__placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          </div>
          <div class="journal-blog__content">
            <div class="journal-blog__meta">
              THE MAKERS / MAY 2026
            </div>
            <h3 class="journal-blog__title">
              Accordion Table wins Big See Award 2025.
            </h3>
            <div class="journal-blog__excerpt">
              The leading product design award in Sout...
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal Blog Posts",
  "tag": "section",
  "class": "section-journal-blog",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "JOURNAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "At the table."
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all stories text",
      "default": "VIEW ALL STORIES"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link URL (defaults to blog URL)"
    },
    {
      "type": "header",
      "content": "Blog Source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Number of articles to display",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Card Display Settings"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category/tag",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show published date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show short excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "excerpt_limit",
      "label": "Excerpt character limit",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & article title color",
      "default": "#14110e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (Eyebrow & hover)",
      "default": "#c79b6b"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Category & date color",
      "default": "#8c867f"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt text color",
      "default": "#5c564f"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container maximum width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid column gap",
      "min": 16,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Journal Blog Posts",
      "settings": {
        "eyebrow": "JOURNAL",
        "heading": "At the table.",
        "view_all_text": "VIEW ALL STORIES",
        "post_limit": 4,
        "show_image": true,
        "show_category": true,
        "show_date": true,
        "show_excerpt": true,
        "excerpt_limit": 80
      }
    }
  ]
}
{% endschema %}
