{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link href="https://cdn.jsdelivr.net/npm/@fontsource/mona-sans@5/400.css" rel="stylesheet">

{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign divider_color = s.text_color | color_modify: 'alpha', 0.2
-%}

<div
  class="anb anb--{{ section_id }}"
  data-section-id="{{ section_id }}"
  data-section-type="announcement-bar"
  style="
    --anb-bg: {{ s.background_color }};
    --anb-text: {{ s.text_color }};
    --anb-icon: {{ s.icon_color }};
    --anb-divider: {{ divider_color }};
  "
>
  <div class="anb__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign icon = block.settings.icon
        assign has_link = false
        if block.settings.link != blank
          assign has_link = true
        endif
      -%}

      {%- if forloop.index > 1 -%}
        <span class="anb__divider" aria-hidden="true"></span>
      {%- endif -%}

      {%- if has_link -%}<a href="{{ block.settings.link }}" class="anb__item anb__item--link" {{ block.shopify_attributes }}>{%- else -%}<div class="anb__item" {{ block.shopify_attributes }}>{%- endif -%}

        <span class="anb__icon" aria-hidden="true">
          {%- if block.settings.custom_icon != blank -%}
            {{ block.settings.custom_icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' }}
          {%- elsif icon == 'truck' -%}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1.5 5h9v8h-9V5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
              <path d="M10.5 8.5h3.6L16.5 11v2h-6V8.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
              <circle cx="5" cy="15" r="1.6" stroke="currentColor" stroke-width="1.2"/>
              <circle cx="13.5" cy="15" r="1.6" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          {%- elsif icon == 'home' -%}
            <svg width="19" height="20" viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 9.5 9.5 2l7.5 7.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M4 8v9h11V8" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
              <path d="M9.5 17.2c-1.6-1.4-2.9-2.6-2.9-4.1a1.9 1.9 0 0 1 2.9-1.6 1.9 1.9 0 0 1 2.9 1.6c0 1.5-1.3 2.7-2.9 4.1Z" fill="currentColor" stroke="currentColor" stroke-width="0.6"/>
            </svg>
          {%- elsif icon == 'gift' -%}
            <svg width="19" height="20" viewBox="0 0 19 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="7.5" width="15" height="10.5" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
              <path d="M1.5 4.5h16v3h-16v-3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
              <path d="M9.5 4.5v13.5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M9.5 4.5c0-1.7-1.3-3-2.9-3C5.2 1.5 4.8 3.4 6 4.2c.7.4 2 .3 3.5.3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
              <path d="M9.5 4.5c0-1.7 1.3-3 2.9-3 1.4 0 1.8 1.9.6 2.7-.7.4-2 .3-3.5.3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
            </svg>
          {%- elsif icon == 'concierge' -%}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 16h16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              <path d="M3.5 16v-3.2A6.5 6.5 0 0 1 10 6.3a6.5 6.5 0 0 1 6.5 6.5V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M10 3.2V6.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              <circle cx="10" cy="2" r="1" fill="currentColor"/>
              <circle cx="10" cy="12.8" r="1.1" fill="currentColor"/>
            </svg>
          {%- endif -%}
        </span>

        <span class="anb__text">{{ block.settings.text }}</span>

      {%- if has_link -%}</a>{%- else -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "div",
  "class": "anb-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#14110e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f6f3ee"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#c79b6b"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "home", "label": "Home" },
            { "value": "gift", "label": "Gift" },
            { "value": "concierge", "label": "Concierge" },
            { "value": "none", "label": "None" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Optional. Overrides the preset icon above."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free White Glove Delivery"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Makes this item clickable."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "text": "Free White Glove Delivery" } },
        { "type": "item", "settings": { "icon": "home", "text": "30-Day Home Trial" } },
        { "type": "item", "settings": { "icon": "gift", "text": "Warm Welcome Gift Included" } },
        { "type": "item", "settings": { "icon": "concierge", "text": "Trade / B2B Program" } }
      ]
    }
  ]
}
{% endschema %}
