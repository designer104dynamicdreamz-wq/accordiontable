{{ 'hero-banner-nav.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings

  assign overlay_start = s.overlay_color | color_modify: 'alpha', 0.5
  assign overlay_mid   = s.overlay_color | color_modify: 'alpha', 0.49
  assign overlay_end   = s.overlay_color | color_modify: 'alpha', 0.97
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;1,600&family=DM+Sans:wght@400;500&family=Montserrat:wght@500&display=swap" rel="stylesheet">

<section
  class="hbn hbn--{{ section_id }}{% if s.background_image_mobile != blank %} hbn--has-mobile-media{% endif %}"
  data-section-id="{{ section_id }}"
  data-section-type="hero-banner-nav"
  style="
    --hbn-min-height: {{ s.section_height }}px;
    --hbn-min-height-mobile: {{ s.section_height_mobile }}px;
    --hbn-text-color: {{ s.text_color }};
    --hbn-subheading-color: {{ s.subheading_color }};
    --hbn-accent-color: {{ s.accent_color }};
    --hbn-dark-color: {{ s.dark_color }};
    --hbn-overlay-start: {{ overlay_start }};
    --hbn-overlay-mid: {{ overlay_mid }};
    --hbn-overlay-end: {{ overlay_end }};
  ">
  {%- if s.background_video != blank -%}
    <div class="hbn__media hbn__media--desktop">
      {{ s.background_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    </div>
  {%- elsif s.background_image != blank -%}
    <div class="hbn__media hbn__media--desktop">
      {{ s.background_image | image_url: width: 2400 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '750,990,1400,1800,2400',
        alt: s.background_image.alt | default: s.heading
      }}
    </div>
  {%- else -%}
    <div class="hbn__media hbn__media--placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'hbn__placeholder-svg' }}</div>
  {%- endif -%}

  {%- if s.background_image_mobile != blank -%}
    <div class="hbn__media hbn__media--mobile">
      {{ s.background_image_mobile | image_url: width: 1200 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '480,750,1200',
        alt: s.background_image_mobile.alt | default: s.heading
      }}
    </div>
  {%- endif -%}

  <div class="hbn__overlay" aria-hidden="true"></div>


  {% comment %} Hero navigation header disabled temporarily. {% endcomment %}
  {% comment %}
  <header class="hbn__header">
    <div class="hbn__header-inner">

      <div class="hbn__logo">
        <a href="{{ routes.root_url }}">
          {%- if s.logo_image != blank -%}
            <img
              src="{{ s.logo_image | image_url: width: 416 }}"
              alt="{{ shop.name }}"
              width="{{ s.logo_width }}"
              height="{{ s.logo_width | times: s.logo_image.aspect_ratio | divided_by: 1.0 | round }}"
              loading="eager"
            >
          {%- else -%}
            <span class="hbn__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <input type="checkbox" id="hbn-menu-toggle-{{ section_id }}" class="hbn__menu-checkbox" aria-hidden="true">

      <nav class="hbn__nav" id="hbn-nav-{{ section_id }}">
        <ul class="hbn__nav-list">
          {%- for link in s.menu.links -%}
            <li class="hbn__nav-item">
              <a href="{{ link.url }}" class="hbn__nav-link"{% if link.active %} aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="hbn__icons">
        {%- if s.show_search_icon -%}
          <a href="{{ routes.search_url }}" class="hbn__icon-btn" aria-label="{{ 'general.search.title' | t | default: 'Search' }}">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="9.5" cy="9.5" r="7" stroke="currentColor" stroke-width="1.4"/>
              <path d="M20 20L15 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if s.show_account_icon -%}
          <a href="{{ routes.account_url }}" class="hbn__icon-btn" aria-label="{{ 'customer.account.title' | t | default: 'Account' }}">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="11" cy="7.3" r="3.3" stroke="currentColor" stroke-width="1.4"/>
              <path d="M4.2 18.5c1.2-3.4 3.9-5.2 6.8-5.2s5.6 1.8 6.8 5.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if s.show_cart_icon -%}
          <a href="{{ routes.cart_url }}" class="hbn__icon-btn hbn__icon-btn--cart" aria-label="{{ 'cart.general.title' | t | default: 'Cart' }}">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4 7h14l-1.1 10.1a2 2 0 0 1-2 1.9H7.1a2 2 0 0 1-2-1.9L4 7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              <path d="M7.5 7V5.5a3.5 3.5 0 0 1 7 0V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <span class="hbn__cart-count">{{ cart.item_count }}</span>
          </a>
        {%- endif -%}

        <label for="hbn-menu-toggle-{{ section_id }}" class="hbn__burger" aria-label="{{ 'general.accessibility.menu' | t | default: 'Menu' }}">
          <span></span><span></span><span></span>
        </label>
      </div>

    </div>
  </header>
  {% endcomment %}

  <div class="page-width">
    <div class="hbn__content">
      <div class="hbn__content-inner">

        {%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}
        {%- if badge_blocks.size > 0 -%}
          <div class="hbn__badges">
            {%- for block in badge_blocks -%}
              <span class="hbn__badge" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
              {%- unless forloop.last -%}<span class="hbn__badge-dot" aria-hidden="true"></span>{%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="hbn__text">
          {%- if s.heading != blank or s.heading_accent != blank -%}
            <h1 class="hbn__heading">
              {%- if s.heading != blank -%}<span class="hbn__heading-main">{{ s.heading }} </span>{%- endif -%}
              {%- if s.heading_accent != blank -%}<span class="hbn__heading-accent">{{ s.heading_accent }}</span>{%- endif -%}
            </h1>
          {%- endif -%}

          {%- if s.subheading != blank -%}
            <div class="hbn__subheading">{{ s.subheading }}</div>
          {%- endif -%}
        </div>

        {%- assign button_blocks = section.blocks | where: 'type', 'button' -%}
        {%- if button_blocks.size > 0 -%}
          <div class="hbn__buttons">
            {%- for block in button_blocks -%}
              {%- assign btn_style = block.settings.style -%}
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="hbn__btn hbn__btn--{{ btn_style }}"
                {{ block.shopify_attributes }}
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
              >
                <span>{{ block.settings.label }}</span>
                <svg class="hbn__btn-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1.5 8.5L8.5 1.5M8.5 1.5H3M8.5 1.5V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector('[data-section-id="{{ section_id }}"]');
    const header = section?.querySelector('.hbn__header');

    if (!section || !header) return;

    let ticking = false;

    const updateHeaderState = () => {
      header.classList.toggle('hbn__header--scrolled', window.scrollY > section.offsetTop);
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeaderState);
        ticking = true;
      }
    }, { passive: true });

    updateHeaderState();
  })();
</script>

{% schema %}
{
  "name": "Hero Banner + Nav",
  "tag": "section",
  "class": "hbn-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video (desktop)",
      "info": "Optional. Replaces the desktop background image when selected."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image if not set."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#14110e"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 500,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Section height (desktop)",
      "default": 810
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Section height (mobile)",
      "default": 640
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Leave blank to show the store name as text"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 320,
      "step": 4,
      "unit": "px",
      "label": "Logo width",
      "default": 208
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search_icon",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account_icon",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_icon",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The table that grows with"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent (italic, colored)",
      "default": "every gathering."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Beautifully crafted expandable furniture designed to adapt effortlessly from everyday dining to unforgettable celebrations.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c79b6b"
    },
    {
      "type": "color",
      "id": "dark_color",
      "label": "Dark color (primary button text)",
      "default": "#14110e"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "Solid European Oak"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Shop Dining Tables"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary (filled)" },
            { "value": "secondary", "label": "Secondary (outline)" }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero Banner + Nav",
      "blocks": [
        { "type": "badge", "settings": { "text": "Solid European Oak" } },
        { "type": "badge", "settings": { "text": "Handcrafted in Croatia" } },
        { "type": "button", "settings": { "label": "Shop Dining Tables", "style": "primary" } },
        { "type": "button", "settings": { "label": "Explore Outdoor", "style": "secondary" } }
      ]
    }
  ]
}
{% endschema %}
