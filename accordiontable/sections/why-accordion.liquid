{{ 'why-accordion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign s = section.settings
-%}

<section
  class="why-acc why-acc--{{ section_id }}"
  id="why-acc-{{ section_id }}"
  data-section-id="{{ section_id }}"
  style="
    --why-bg: {{ s.background_color | default: '#ffffff' }};
    --why-text: {{ s.text_color | default: '#14110e' }};
    --why-accent: {{ s.accent_color | default: '#c79b6b' }};
    --why-desc: {{ s.description_color | default: '#5c564f' }};
    --why-card-bg: {{ s.card_background | default: '#ffffff' }};
    --why-border: {{ s.border_color | default: '#ece7e1' }};
    --why-border-hover: {{ s.border_hover_color | default: '#c79b6b' }};
    padding-top: {{ s.padding_top | default: 80 }}px;
    padding-bottom: {{ s.padding_bottom | default: 80 }}px;
  "
>
  <div class="page-width">
    {%- if s.badge_text != blank or s.heading != blank or s.heading_accent != blank or s.subheading != blank -%}
      <div class="why-acc__header">
        {%- if s.badge_text != blank -%}
          <div class="why-acc__badge">
            {{ s.badge_text }}
          </div>
        {%- endif -%}

        {%- if s.heading != blank or s.heading_accent != blank -%}
          <h2 class="why-acc__heading">
            {%- if s.heading != blank -%}<span>{{ s.heading }} </span>{%- endif -%}
            {%- if s.heading_accent != blank -%}<span class="why-acc__heading-accent">{{ s.heading_accent }}</span>{%- endif -%}
          </h2>
        {%- endif -%}

        {%- if s.subheading != blank -%}
          <div class="why-acc__subheading">
            {{ s.subheading }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="why-acc__grid why-acc__grid--{{ s.columns_desktop | default: '3' }}-col">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign icon = b.icon | default: 'gift'
            assign number = b.number
            if number == blank and s.show_numbers
              if forloop.index < 10
                assign number = '0' | append: forloop.index
              else
                assign number = forloop.index
              endif
            endif
          -%}

          <div class="why-acc__card" {{ block.shopify_attributes }}>
            <!-- Top Row: Icon + Number -->
            <div class="why-acc__top-row">
              <div class="why-acc__icon-wrap">
                {%- if b.custom_icon != blank -%}
                  {{ b.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: b.title | default: '' }}
                {%- elsif b.custom_svg != blank -%}
                  {{ b.custom_svg }}
                {%- elsif icon == 'gift' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="8" width="18" height="13" rx="1"/>
                    <path d="M12 8v13"/>
                    <path d="M19 8H5a2 2 0 0 1-2-2 2 2 0 0 1 2-2h14a2 2 0 0 1 2 2 2 2 0 0 1-2 2z"/>
                    <path d="M12 4c-1.5-2.5-4.5-2-5 0s3 4 5 4c2 0 5.5-4 5-4s-3.5-2.5-5 0z"/>
                  </svg>
                {%- elsif icon == 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="1" y="6" width="13" height="10" rx="1"/>
                    <polygon points="14 9 18 9 21 12 21 16 14 16 14 9"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="17.5" cy="18.5" r="2.5"/>
                  </svg>
                {%- elsif icon == 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="9 12 11 14 15 10"/>
                  </svg>
                {%- elsif icon == 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 1 9.2A7 7 0 0 1 11 20z"/>
                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                  </svg>
                {%- elsif icon == 'workshop' or icon == 'badge' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="7"/>
                    <path d="M12 2l2.3 2.1 3.1-.7 1.3 2.8 3 .9-.6 3.1 2 2.4-2 2.4.6 3.1-3 .9-1.3 2.8-3.1-.7L12 22l-2.3-2.1-3.1.7-1.3-2.8-3-.9.6-3.1-2-2.4 2-2.4-.6-3.1 3-.9 1.3-2.8 3.1.7L12 2z"/>
                    <polyline points="9 12 11 14 15 10"/>
                  </svg>
                {%- elsif icon == 'star' or icon == 'guarantee' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polygon points="12 6 13.9 10.2 18.5 10.6 15 13.7 16.1 18.2 12 15.8 7.9 18.2 9 13.7 5.5 10.6 10.1 10.2 12 6"/>
                  </svg>
                {%- elsif icon == 'table' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="3" rx="1"/>
                    <path d="M5 8v12M19 8v12M2 11h20"/>
                  </svg>
                {%- elsif icon == 'tools' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                  </svg>
                {%- endif -%}
              </div>

              {%- if s.show_numbers and number != blank -%}
                <span class="why-acc__number">{{ number }}</span>
              {%- endif -%}
            </div>

            <!-- Content -->
            <div class="why-acc__content">
              {%- if b.title != blank -%}
                <h3 class="why-acc__title">{{ b.title }}</h3>
              {%- endif -%}

              {%- if b.description != blank -%}
                <div class="why-acc__description">
                  {{ b.description }}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Why Accordion",
  "tag": "section",
  "class": "why-accordion-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "WHY ACCORDION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading primary text",
      "default": "Engineered for"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent text (italic, gold)",
      "default": "real life."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show numbers (01, 02, ...)",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & title text color",
      "default": "#14110e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (gold / numbers / badge)",
      "default": "#c79b6b"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description text color",
      "default": "#5c564f"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border color",
      "default": "#ece7e1"
    },
    {
      "type": "color",
      "id": "border_hover_color",
      "label": "Card border hover color",
      "default": "#c79b6b"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Built-in Icon",
          "options": [
            { "value": "gift", "label": "Gift / Box" },
            { "value": "truck", "label": "Truck / Delivery" },
            { "value": "shield", "label": "Shield / Warranty" },
            { "value": "leaf", "label": "Leaf / Eco Oak" },
            { "value": "workshop", "label": "Workshop / Rosette" },
            { "value": "star", "label": "Star / Guarantee" },
            { "value": "table", "label": "Table" },
            { "value": "tools", "label": "Tools / Craft" }
          ],
          "default": "gift"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (optional)"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG code (optional)"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Custom Number (leave blank for automatic 01, 02...)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "Feature Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Card description",
          "default": "<p>Feature description explaining the benefit and craft details.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Accordion",
      "settings": {
        "badge_text": "WHY ACCORDION",
        "heading": "Engineered for",
        "heading_accent": "real life.",
        "show_numbers": true
      },
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "gift",
            "number": "01",
            "title": "Solid European Oak — no veneers",
            "description": "<p>Hand-selected from Croatian forests. Dense, naturally beautiful, built to last decades. Layered lamella construction distributes weight evenly at every length.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "number": "02",
            "title": "One person. No leaves to store.",
            "description": "<p>Hand-selected from Croatian forests. Dense, naturally beautiful, built to last decades. Layered lamella construction distributes weight evenly at every length.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "shield",
            "number": "03",
            "title": "Solid European Oak — no veneers",
            "description": "<p>Hand-selected from Croatian forests. Dense, naturally beautiful, built to last decades. Layered lamella construction distributes weight evenly at every length.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "leaf",
            "number": "04",
            "title": "Spill and scratch resistant",
            "description": "<p>Hardened natural oil finish protects against everyday wear, wine, and scratches while preserving the warmth of the wood grain beneath.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "workshop",
            "number": "05",
            "title": "3rd-generation family workshop",
            "description": "<p>Made in Croatia. Over 40 hours of craftsmanship per table. Sustainably sourced local oak, minimal transport, knowledge passed down across three generations.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "star",
            "number": "06",
            "title": "10-year warranty, 30-day returns.",
            "description": "<p>If it's not right, we collect the table and refund you completely. No questions asked. The warranty covers the mechanism, the finish, and the joinery.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
